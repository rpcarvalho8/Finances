# ═══════════════════════════════════════════════════════
# Finance OS — Configuração
# cp .env.example .env.local   (desenvolvimento)
# cp .env.example .env         (produção Docker)
# ═══════════════════════════════════════════════════════

# ── AI Advisor (obrigatório para IA funcionar) ───────────
# Obtém em: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Segurança ─────────────────────────────────────────────
AUTH_SECRET=MUDA_ISTO_PARA_STRING_ALEATORIA
RUI_PASSWORD=password_do_rui
ANA_PASSWORD=password_da_ana

# ── Base de dados ──────────────────────────────────────────
DATABASE_URL=file:./data/finance.db

# ── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Finance OS
NODE_ENV=production
PORT=3000

# ── Enable Banking (Open Banking / PSD2) ───────────────────
# The previously committed application key/keypair is burned.
# Rotate a new key in the Enable Banking console, then set:
ENABLE_BANKING_APPLICATION_KEY=
# Prefer PEM text in env (PKCS#8). Do not commit .pem files.
ENABLE_BANKING_APPLICATION_SECRET=
# Optional alternative: absolute path to an out-of-repo private key file.
# ENABLE_BANKING_PRIVATE_KEY_PATH=
ENABLE_BANKING_REDIRECT_URI=
ENABLE_BANKING_ASPSP_COUNTRY=
ENABLE_BANKING_ASPSP_NAME=

# ── APIs de investimentos (opcional) ──────────────────────
XTB_ACCOUNT_ID=
XTB_PASSWORD=

IBKR_HOST=localhost
IBKR_PORT=7497
IBKR_CLIENT_ID=1

BYBIT_API_KEY=
BYBIT_SECRET=

BINANCE_API_KEY=
BINANCE_SECRET=

TRADING212_API_KEY=
